NODE_ENV=development
PORT=5000
APP_NAME=web-security-assessment-platform

MONGODB_URI=mongodb://localhost:27017/web-security-assessment-platform

REDIS_URL=redis://redis:6379

USER_TIER=free

AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=web-security-assessment-platform/reports

SCAN_QUEUE_NAME=security-scan
REPORT_QUEUE_NAME=security-report
CLEANUP_QUEUE_NAME=security-cleanup
NOTIFICATION_QUEUE_NAME=security-notification

SCAN_CONCURRENCY=3
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000

HTTP_REQUEST_TIMEOUT_MS=10000
HTTP_RESPONSE_SIZE_LIMIT_BYTES=5242880

MAX_CRAWL_PATHS_FREE=25
MAX_CRAWL_DEPTH_FREE=2
MAX_CONCURRENT_SCANS_FREE=1
DAILY_SCAN_LIMIT_FREE=5
REQUEST_RATE_LIMIT_FREE=2

MAX_CRAWL_PATHS_PRO=250
MAX_CRAWL_DEPTH_PRO=5
MAX_CONCURRENT_SCANS_PRO=3
MONTHLY_SCAN_LIMIT_PRO=200
REQUEST_RATE_LIMIT_PRO=20

LOG_LEVEL=info