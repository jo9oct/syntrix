    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "morgan": "^1.12.0",
    "puppeteer-core": "^25.12.0",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "deep-is": "^0.1.4",
