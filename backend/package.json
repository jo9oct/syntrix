
{
  "name": "web-security-assessment-platform",
  "version": "1.0.0",
  "description": "Professional authorized web security assessment platform backend built with Express.js.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:worker": "node worker.js",
    "dev": "nodemon server.js",
    "dev:worker": "node --watch worker.js",
    "dev:typescript": "tsx watch src/server.ts",
    "seed": "tsx src/seed.ts",
    "build:typescript": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.58.5",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "morgan": "^1.12.0",
    "nodemon": "^3.1.14",
    "puppeteer-core": "^25.12.0",
    "redis": "^5.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.5.0",
    "eslint": "^9.35.0",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
